# ── Veritas Dev – Docker local ─────────────────────────────────────────────
# Copy this file to .env and fill in real values before running Docker Compose.
# NEVER commit the actual .env file to source control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=veritas
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=veritas_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=veritas_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=veritas-documents

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Service URLs (used by prod nginx / inter-service calls) ──────────────────
AUTH_SERVICE_URL=http://auth-service:8001
FRONTEND_URL=http://localhost

DOCUMENT_GRPC_HOST=document-service
DOCUMENT_GRPC_PORT=50053

MODELS_DIR=/app/models
DEFAULT_MODEL=distilbert-base-uncased
MAX_TEXT_LENGTH=10000

NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=VeritasAI
NEXT_PUBLIC_APP_VERSION=1.0.0

FRONTEND_PORT=3000
AUTH_PORT=8001
AI_PORT=8002
DOCUMENT_PORT=8003
ANALYTICS_PORT=8004
TRAEFIK_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost/auth/google/callback
# For production: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
# Use sk_test_... and pk_test_... for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get webhook secret from: stripe listen --forward-to localhost:8001/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Create Products in Stripe dashboard, then copy the Price IDs here
STRIPE_PRO_PRICE_ID=price_pro_monthly_id
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly_id

# ── Subscription Plan Quotas ──────────────────────────────────────────────────
FREE_DAILY_LIMIT=10
FREE_MAX_CHARS=2000
PRO_DAILY_LIMIT=500
PRO_MAX_CHARS=10000
ENTERPRISE_DAILY_LIMIT=0
ENTERPRISE_MAX_CHARS=50000
